{
  "name": "gorod-dela",
  "version": "0.0.1",
  "description": "Симулятор предпринимателя в живом городе",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
    "build:yandex": "tsc && vite build --mode yandex --outDir dist-yandex && node scripts/zip-portal.mjs yandex",
    "build:vk": "tsc && vite build --mode vk --outDir dist-vk && node scripts/zip-portal.mjs vk",
    "build:crazygames": "tsc && vite build --mode crazygames --outDir dist-crazygames && node scripts/zip-portal.mjs crazygames"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valikkirov/gorod-dela.git"
  },
  "bugs": {
    "url": "https://github.com/valikkirov/gorod-dela/issues"
  },
  "homepage": "https://github.com/valikkirov/gorod-dela#readme",
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@vkontakte/vk-bridge": "^3.0.2",
    "lz-string": "^1.5.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
